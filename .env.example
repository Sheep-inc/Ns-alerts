# NS API key (https://apiportal.ns.nl, product "Ns-App")
NS_API_KEY=
# Eerste start, alleen als er nog geen gebruikers zijn: beheerder.
# Gebruikersnaam 3-32 tekens (letters, cijfers, . _ -), wachtwoord minimaal 8.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optioneel: topic en server die bij de import van data/config.json naar de beheerder gaan.
# Zonder NTFY_TOPIC krijgt elke gebruiker een eigen onraadbaar topic.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Zet op 1 alleen als ntfy op een privé-adres draait (localhost, 10/8, 192.168/16, …).
# NTFY_ALLOW_PRIVATE=0
# Zet op 1 achter HTTPS, zodat het sessiecookie het Secure-attribuut krijgt.
# COOKIE_SECURE=0
# PORT=8780
# DATA_DIR=./data
# POLL_SEC=120
# Eerste start: als data/subscriptions.json ontbreekt, wordt dit bestand gekopieerd en daarna bij de beheerder geïmporteerd.
# SEED_FILE=./seed/subscriptions.json
# Standaard voor nieuwe gebruikers. Dagelijkse storingscheck, tijden in Europe/Amsterdam.
# DIGEST_TIMES=06:00,21:00
# DIGEST_ENABLED=1
# DIGEST_QUIET=0
# SCRYPT_N niet zetten in productie (standaard 16384). Alleen verlagen in tests.
