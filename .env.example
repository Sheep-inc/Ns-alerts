# NS API key (https://apiportal.ns.nl, product "Ns-App")
NS_API_KEY=
# Optioneel: vast ntfy-topic (anders wordt er één willekeurig gegenereerd in data/config.json)
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Optioneel: wachtwoord voor de web-UI (basic auth, gebruikersnaam maakt niet uit)
UI_PASSWORD=
# PORT=8780
# DATA_DIR=./data
# Eerste start: als data/subscriptions.json ontbreekt, wordt dit bestand gekopieerd
# SEED_FILE=./seed/subscriptions.json
