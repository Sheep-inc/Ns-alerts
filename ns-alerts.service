# Kopieer naar /etc/systemd/system/ns-alerts.service en pas paden/gebruiker aan.
# Vereist Node.js 20 of nieuwer (/usr/bin/node).
[Unit]
Description=NS treinalerts
After=network-online.target
Wants=network-online.target

[Service]
User=nsalerts
WorkingDirectory=/opt/ns-alerts
EnvironmentFile=/opt/ns-alerts/.env
Environment=TZ=Europe/Amsterdam
ExecStart=/usr/bin/node /opt/ns-alerts/app.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/ns-alerts/data

[Install]
WantedBy=multi-user.target
